
#include <iostream>
using namespace std;

class Point3D {
private:
    const double x;
    const double y;
    const double z;

public:
    Point3D(double a, double b, double c)
        : x(a), y(b), z(c) {
        cout << "Constructeur Point3D" << endl;
    }

    double getX() const {
        return x;
    }

    double getY() const {
        return y;
    }

    double getZ() const {
        return z;
    }

    void afficher() const {
        cout << "Coordonnees : ("
             << x << ", "
             << y << ", "
             << z << ")" << endl;
    }
};

int main() {
    Point3D p(1.0, 2.0, 3.0);

    p.afficher();

    return 0;
}
