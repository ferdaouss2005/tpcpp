#include <iostream>
#include <algorithm>
#include <utility>
using namespace std;

class Buffer {
private:
    char* data;
    size_t taille;

public:
    // Constructeur
    Buffer(size_t t = 0) : data(nullptr), taille(t) {
        if (taille > 0)
            data = new char[taille]{};

        cout << "Constructeur" << endl;
    }

    // Constructeur de copie
    Buffer(const Buffer& autre) : data(nullptr), taille(autre.taille) {
        if (taille > 0) {
            data = new char[taille];
            copy(autre.data, autre.data + taille, data);
        }

        cout << "Constructeur de copie" << endl;
    }

    // Constructeur de deplacement
    Buffer(Buffer&& autre) noexcept
        : data(autre.data), taille(autre.taille) {
        autre.data = nullptr;
        autre.taille = 0;

        cout << "Constructeur de deplacement" << endl;
    }

    // Operateur d'affectation par copie
    Buffer& operator=(const Buffer& autre) {
        if (this != &autre) {
            char* nouveau = nullptr;

            if (autre.taille > 0) {
                nouveau = new char[autre.taille];
                copy(autre.data, autre.data + autre.taille, nouveau);
            }

            delete[] data;
            data = nouveau;
            taille = autre.taille;
        }

        cout << "Affectation par copie" << endl;
        return *this;
    }

    // Operateur d'affectation par deplacement
    Buffer& operator=(Buffer&& autre) noexcept {
        if (this != &autre) {
            delete[] data;

            data = autre.data;
            taille = autre.taille;

            autre.data = nullptr;
            autre.taille = 0;
        }

        cout << "Affectation par deplacement" << endl;
        return *this;
    }

    // Destructeur
    ~Buffer() {
        delete[] data;
        cout << "Destructeur" << endl;
    }

    size_t getTaille() const {
        return taille;
    }
};

int main() {
    Buffer b1(128);

    Buffer b2 = b1;

    Buffer b3 = move(b1);

    b2 = b3;

    b3 = Buffer(64);

    cout << "Taille de b2 : " << b2.getTaille() << endl;
    cout << "Taille de b3 : " << b3.getTaille() << endl;

    return 0;
}


